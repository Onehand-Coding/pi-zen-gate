{
  "name": "pi-zen-gate",
  "version": "0.2.0",
  "description": "Keyless OpenCode Zen free models for Pi, using native HTTP APIs",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "pi-package",
    "pi",
    "opencode",
    "zen"
  ],
  "files": [
    "src/**/*.ts",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "scripts": {
    "test": "node --experimental-strip-types --test test/*.test.ts",
    "check": "tsc --noEmit",
    "test:live": "node --experimental-strip-types test/live.ts",
    "check:package": "npm pack --dry-run --ignore-scripts",
    "verify": "npm run check && npm test && npm run check:package"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "dependencies": {},
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "0.86.1",
    "@earendil-works/pi-coding-agent": "0.86.1",
    "@types/node": "^22.0.0",
    "typescript": "^5.9.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Onehand-Coding/pi-zen-gate.git"
  },
  "homepage": "https://github.com/Onehand-Coding/pi-zen-gate#readme",
  "bugs": {
    "url": "https://github.com/Onehand-Coding/pi-zen-gate/issues"
  }
}
